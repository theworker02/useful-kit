{
  "name": "useful-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "300 useful browser tools, shipped in batches of five. Static site for GitHub Pages.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4321",
    "build": "tsc --noEmit && vite build",
